!-Generator IDFEditor 1.00
!- Eco-Loop Building Agents - baseline.idf
!- A single-zone office model used for BOTH the baseline (fixed-schedule)
!- and AI-controlled runs. The AI run overrides CLG_SETPOINT_SCHED and
!- HTG_SETPOINT_SCHED at runtime via EMS actuators (see
!- app/simulation/actuators.py); the baseline run leaves them untouched,
!- representing a conventional fixed-schedule BMS.
!- RunPeriod length/start date is rewritten automatically at runtime
!- from .env (SIMULATION_DAYS, RUN_PERIOD_START_MONTH/DAY) - see
!- app/simulation/energyplus_runner.py::_prepare_idf_with_run_period.

  Version,24.2;

  SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes,                     !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

  Building,
    Eco-Loop Demo Building,  !- Name
    0,                       !- North Axis {deg}
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullExterior,            !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

  Timestep,4;

  Site:Location,
    Generic City,            !- Name
    37.62,                   !- Latitude {deg}
    -122.40,                 !- Longitude {deg}
    -8.0,                    !- Time Zone {hr}
    2.0;                     !- Elevation {m}

  RunPeriod,
    Eco-Loop Run,            !- Name
    7,                       !- Begin Month
    1,                       !- Begin Day of Month
    2024,                    !- Begin Year
    7,                       !- End Month
    3,                       !- End Day of Month
    2024,                    !- End Year
    ,                        !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    No,                      !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators

  GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    CounterClockWise,        !- Vertex Entry Direction
    Relative;                !- Coordinate System

! ============================================================
! SCHEDULES
! ============================================================

  ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

  ScheduleTypeLimits,
    Temperature,             !- Name
    -60,                     !- Lower Limit Value
    200,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

  ScheduleTypeLimits,
    Count,                   !- Name
    0,                       !- Lower Limit Value
    100,                     !- Upper Limit Value
    Continuous;              !- Numeric Type

  ScheduleTypeLimits,
    ControlType,             !- Name
    0,                       !- Lower Limit Value
    4,                       !- Upper Limit Value
    Discrete;                !- Numeric Type

! Occupancy: 0 people overnight, ramps up 8-9am, 8 people 9am-6pm, ramps down, repeats daily.

  Schedule:Compact,
    OCC_SCHED,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 08:00,0.0,        !- Field 3
    Until: 09:00,0.5,        !- Field 5
    Until: 18:00,1.0,        !- Field 7
    Until: 19:00,0.3,        !- Field 9
    Until: 24:00,0.0;        !- Field 11

  Schedule:Compact,
    LIGHTS_SCHED,            !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 07:00,0.05,       !- Field 3
    Until: 19:00,0.9,        !- Field 5
    Until: 24:00,0.05;       !- Field 7

  Schedule:Compact,
    EQUIP_SCHED,             !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 07:00,0.10,       !- Field 3
    Until: 19:00,0.80,       !- Field 5
    Until: 24:00,0.10;       !- Field 7

  Schedule:Compact,
    ALWAYS_ON,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,1.0;        !- Field 3

  Schedule:Compact,
    ACTIVITY_SCHED,          !- Name
    Any Number,              !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,120;        !- Field 3

  Schedule:Compact,
    ZONE_CONTROL_TYPE_SCHED, !- Name
    ControlType,             !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,4;          !- Field 3

! These two schedules are the ONLY objects the closed-loop controller
! writes to at runtime via EMS actuators (Schedule:Constant / Schedule Value).
! Baseline run: left at these fixed default values for the whole simulation.
! AI run: overwritten every control interval by app/simulation/actuators.py.

  Schedule:Constant,CLG_SETPOINT_SCHED,Temperature,24.0;

  Schedule:Constant,HTG_SETPOINT_SCHED,Temperature,21.0;

! ============================================================
! MATERIALS & CONSTRUCTIONS (simple, code-typical envelope)
! ============================================================

  Material,
    Concrete Block,          !- Name
    MediumRough,             !- Roughness
    0.2032,                  !- Thickness {m}
    0.72,                    !- Conductivity {W/m-K}
    1000,                    !- Density {kg/m3}
    920;                     !- Specific Heat {J/kg-K}

  Material,
    Insulation Board,        !- Name
    MediumRough,             !- Roughness
    0.0508,                  !- Thickness {m}
    0.03,                    !- Conductivity {W/m-K}
    43,                      !- Density {kg/m3}
    1210;                    !- Specific Heat {J/kg-K}

  Material,
    Gypsum Board,            !- Name
    Smooth,                  !- Roughness
    0.0127,                  !- Thickness {m}
    0.16,                    !- Conductivity {W/m-K}
    800,                     !- Density {kg/m3}
    1090;                    !- Specific Heat {J/kg-K}

  Material:NoMass,
    Roof Insulation,         !- Name
    Rough,                   !- Roughness
    2.0,                     !- Thermal Resistance {m2-K/W}
    0.9,                     !- Thermal Absorptance
    0.7,                     !- Solar Absorptance
    0.7;                     !- Visible Absorptance

  Material,
    Built-up Roofing,        !- Name
    Rough,                   !- Roughness
    0.0095,                  !- Thickness {m}
    0.16,                    !- Conductivity {W/m-K}
    1121,                    !- Density {kg/m3}
    1460;                    !- Specific Heat {J/kg-K}

  Material,
    Slab Floor Concrete,     !- Name
    MediumRough,             !- Roughness
    0.1016,                  !- Thickness {m}
    1.13,                    !- Conductivity {W/m-K}
    2000,                    !- Density {kg/m3}
    1000;                    !- Specific Heat {J/kg-K}

  WindowMaterial:SimpleGlazingSystem,
    Window Glass,            !- Name
    2.8,                     !- U-Factor {W/m2-K}
    0.6,                     !- Solar Heat Gain Coefficient
    0.6;                     !- Visible Transmittance

  Construction,
    Exterior Wall,           !- Name
    Concrete Block,          !- Outside Layer
    Insulation Board,        !- Layer 2
    Gypsum Board;            !- Layer 3

  Construction,
    Roof,                    !- Name
    Built-up Roofing,        !- Outside Layer
    Roof Insulation;         !- Layer 2

  Construction,
    Floor Slab,              !- Name
    Slab Floor Concrete;     !- Outside Layer

  Construction,
    Exterior Window,         !- Name
    Window Glass;            !- Outside Layer

! ============================================================
! ZONE GEOMETRY - one 10m x 8m x 3m rectangular zone
! ============================================================

  Zone,
    MAIN_ZONE,               !- Name
    0,                       !- Direction of Relative North {deg}
    0,                       !- X Origin {m}
    0,                       !- Y Origin {m}
    0,                       !- Z Origin {m}
    1,                       !- Type
    1,                       !- Multiplier
    autocalculate,           !- Ceiling Height {m}
    autocalculate;           !- Volume {m3}

  BuildingSurface:Detailed,
    Wall_South,              !- Name
    Wall,                    !- Surface Type
    Exterior Wall,           !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Outdoors,                !- Space Name
    ,                        !- Outside Boundary Condition
    SunExposed,              !- Outside Boundary Condition Object
    WindExposed,             !- Sun Exposure
    0.5,                     !- Wind Exposure
    4,                       !- View Factor to Ground
    0,                       !- Number of Vertices

  BuildingSurface:Detailed,
    Wall_East,               !- Name
    Wall,                    !- Surface Type
    Exterior Wall,           !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Outdoors,                !- Space Name
    ,                        !- Outside Boundary Condition
    SunExposed,              !- Outside Boundary Condition Object
    WindExposed,             !- Sun Exposure
    0.5,                     !- Wind Exposure
    4,                       !- View Factor to Ground
    10,                      !- Number of Vertices
    0,3,10,  !- X,Y,Z ==> Vertex 1 {m}
    0,0,10,  !- X,Y,Z ==> Vertex 2 {m}
    8,0,10,  !- X,Y,Z ==> Vertex 3 {m}
    8,3,,  !- X,Y,Z ==> Vertex 4 {m}
    ,,,  !- X,Y,Z ==> Vertex 5 {m}
    ,,,  !- X,Y,Z ==> Vertex 6 {m}
    ,,,  !- X,Y,Z ==> Vertex 7 {m}
    ,,,  !- X,Y,Z ==> Vertex 8 {m}
    ,,,  !- X,Y,Z ==> Vertex 9 {m}
    ,,;  !- X,Y,Z ==> Vertex 10 {m}

  BuildingSurface:Detailed,
    Wall_North,              !- Name
    Wall,                    !- Surface Type
    Exterior Wall,           !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Outdoors,                !- Space Name
    ,                        !- Outside Boundary Condition
    SunExposed,              !- Outside Boundary Condition Object
    WindExposed,             !- Sun Exposure
    0.5,                     !- Wind Exposure
    4,                       !- View Factor to Ground
    10,                      !- Number of Vertices
    8,3,10,  !- X,Y,Z ==> Vertex 1 {m}
    8,0,0,  !- X,Y,Z ==> Vertex 2 {m}
    8,0,0,  !- X,Y,Z ==> Vertex 3 {m}
    8,3,,  !- X,Y,Z ==> Vertex 4 {m}
    ,,,  !- X,Y,Z ==> Vertex 5 {m}
    ,,,  !- X,Y,Z ==> Vertex 6 {m}
    ,,,  !- X,Y,Z ==> Vertex 7 {m}
    ,,,  !- X,Y,Z ==> Vertex 8 {m}
    ,,,  !- X,Y,Z ==> Vertex 9 {m}
    ,,;  !- X,Y,Z ==> Vertex 10 {m}

  BuildingSurface:Detailed,
    Wall_West,               !- Name
    Wall,                    !- Surface Type
    Exterior Wall,           !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Outdoors,                !- Space Name
    ,                        !- Outside Boundary Condition
    SunExposed,              !- Outside Boundary Condition Object
    WindExposed,             !- Sun Exposure
    0.5,                     !- Wind Exposure
    4,                       !- View Factor to Ground
    0,                       !- Number of Vertices

  BuildingSurface:Detailed,
    Floor,                   !- Name
    Floor,                   !- Surface Type
    Floor Slab,              !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Ground,                  !- Space Name
    ,                        !- Outside Boundary Condition
    NoSun,                   !- Outside Boundary Condition Object
    NoWind,                  !- Sun Exposure
    1.0,                     !- Wind Exposure
    4,                       !- View Factor to Ground
    0,                       !- Number of Vertices

  BuildingSurface:Detailed,
    Roof,                    !- Name
    Roof,                    !- Surface Type
    Roof,                    !- Construction Name
    MAIN_ZONE,               !- Zone Name
    Outdoors,                !- Space Name
    ,                        !- Outside Boundary Condition
    SunExposed,              !- Outside Boundary Condition Object
    WindExposed,             !- Sun Exposure
    0,                       !- Wind Exposure
    4,                       !- View Factor to Ground
    0,                       !- Number of Vertices

  FenestrationSurface:Detailed,
    South Window,            !- Name
    Window,                  !- Surface Type
    Exterior Window,         !- Construction Name
    Wall_South,              !- Building Surface Name
    ,                        !- Outside Boundary Condition Object
    autocalculate,           !- View Factor to Ground
    ,                        !- Frame and Divider Name
    ,                        !- Multiplier
    4,                       !- Number of Vertices
    2,0,2.5,  !- X,Y,Z ==> Vertex 1 {m}
    2,0,0.9,  !- X,Y,Z ==> Vertex 2 {m}
    8,0,0.9,  !- X,Y,Z ==> Vertex 3 {m}
    8,0,2.5;  !- X,Y,Z ==> Vertex 4 {m}

! ============================================================
! INTERNAL LOADS
! ============================================================

  People,
    MAIN_ZONE People,        !- Name
    MAIN_ZONE,               !- Zone or ZoneList or Space or SpaceList Name
    OCC_SCHED,               !- Number of People Schedule Name
    People,                  !- Number of People Calculation Method
    8,                       !- Number of People
    ,                        !- People per Floor Area {person/m2}
    ,                        !- Floor Area per Person {m2/person}
    0.3,                     !- Fraction Radiant
    ,                        !- Sensible Heat Fraction
    ACTIVITY_SCHED,          !- Activity Level Schedule Name
    ,                        !- Carbon Dioxide Generation Rate {m3/s-W}
    ,                        !- Enable ASHRAE 55 Comfort Warnings
    ,                        !- Mean Radiant Temperature Calculation Type
    ,                        !- Surface Name/Angle Factor List Name
    Fanger;                  !- Work Efficiency Schedule Name

  Lights,
    MAIN_ZONE Lights,        !- Name
    MAIN_ZONE,               !- Zone or ZoneList or Space or SpaceList Name
    LIGHTS_SCHED,            !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Lighting Level {W}
    10,                      !- Watts per Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Return Air Fraction
    0.4,                     !- Fraction Radiant
    0.2,                     !- Fraction Visible
    0.0;                     !- Fraction Replaceable

  ElectricEquipment,
    MAIN_ZONE Equipment,     !- Name
    MAIN_ZONE,               !- Zone or ZoneList or Space or SpaceList Name
    EQUIP_SCHED,             !- Schedule Name
    Watts/Area,              !- Design Level Calculation Method
    ,                        !- Design Level {W}
    8,                       !- Watts per Floor Area {W/m2}
    ,                        !- Watts per Person {W/person}
    0.0,                     !- Fraction Latent
    0.3,                     !- Fraction Radiant
    0.0;                     !- Fraction Lost

  ZoneInfiltration:DesignFlowRate,
    MAIN_ZONE Infiltration,  !- Name
    MAIN_ZONE,               !- Zone or ZoneList or Space or SpaceList Name
    ALWAYS_ON,               !- Schedule Name
    Flow/Zone,               !- Design Flow Rate Calculation Method
    0.03,                    !- Design Flow Rate {m3/s}
    ,                        !- Flow Rate per Floor Area {m3/s-m2}
    ,                        !- Flow Rate per Exterior Surface Area {m3/s-m2}
    ,                        !- Air Changes per Hour {1/hr}
    0,                       !- Constant Term Coefficient
    1,                       !- Temperature Term Coefficient
    0,                       !- Velocity Term Coefficient
    0;                       !- Velocity Squared Term Coefficient

! ============================================================
! HVAC - Ideal Loads Air System with dual setpoint thermostat.
! Explicit (non-autosize) capacities so no Sizing:Zone / design-day
! objects are required to run this model.
! ============================================================

  ZoneControl:Thermostat,
    MAIN_ZONE Thermostat,    !- Name
    MAIN_ZONE,               !- Zone or ZoneList Name
    ZONE_CONTROL_TYPE_SCHED, !- Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
    MAIN_ZONE DualSetpoint;  !- Control 1 Name

  ThermostatSetpoint:DualSetpoint,
    MAIN_ZONE DualSetpoint,  !- Name
    HTG_SETPOINT_SCHED,      !- Heating Setpoint Temperature Schedule Name
    CLG_SETPOINT_SCHED;      !- Cooling Setpoint Temperature Schedule Name

  ZoneHVAC:EquipmentConnections,
    MAIN_ZONE,               !- Zone Name
    MAIN_ZONE Equipment List,!- Zone Conditioning Equipment List Name
    MAIN_ZONE Supply Inlet,  !- Zone Air Inlet Node or NodeList Name
    ,                        !- Zone Air Exhaust Node or NodeList Name
    MAIN_ZONE Air Node,      !- Zone Air Node Name
    MAIN_ZONE Exhaust Node;  !- Zone Return Air Node or NodeList Name

  ZoneHVAC:EquipmentList,
    MAIN_ZONE Equipment List,!- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:IdealLoadsAirSystem,  !- Zone Equipment 1 Object Type
    MAIN_ZONE Ideal Loads,   !- Zone Equipment 1 Name
    1,                       !- Zone Equipment 1 Cooling Sequence
    1,                       !- Zone Equipment 1 Heating or No-Load Sequence
    ,                        !- Zone Equipment 1 Sequential Cooling Fraction Schedule Name
    ;                        !- Zone Equipment 1 Sequential Heating Fraction Schedule Name

! ============================================================
! OUTPUT
! ============================================================

  OutputControl:Table:Style,
    CommaAndHTML;            !- Column Separator

  Output:VariableDictionary,Regular;

  Output:Variable,*,Zone Mean Air Temperature,Timestep;

  Output:Variable,*,Site Outdoor Air Drybulb Temperature,Timestep;

  Output:Variable,*,Zone People Occupant Count,Timestep;

  Output:Variable,*,Facility Total HVAC Electricity Demand Rate,Timestep;

  Output:Variable,*,Facility Total Electricity Demand Rate,Timestep;

  Output:Variable,*,Zone Air System Sensible Cooling Rate,Timestep;

  Output:Variable,*,Zone Air System Sensible Heating Rate,Timestep;

  Output:Variable,*,Zone Air Relative Humidity,Timestep;

  Output:Meter,Electricity:Facility,Timestep;

  Output:Meter,Electricity:HVAC,Timestep;

