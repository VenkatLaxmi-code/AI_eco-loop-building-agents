# =========================================================
# Eco-Loop Building Agents - Environment Configuration
# Copy this file to .env and fill in the values for your machine.
# NEVER commit your real .env file.
# =========================================================

# ---------------------------------------------------------
# EnergyPlus configuration
# ---------------------------------------------------------
# Full path to your EnergyPlus installation directory.
# Windows example: C:\EnergyPlusV24-1-0
# Linux example:   /usr/local/EnergyPlus-24-1-0
# macOS example:   /Applications/EnergyPlus-24-1-0
ENERGYPLUS_HOME=C:\EnergyPlusV24-1-0

# Path to the pyenergyplus API folder. It normally lives INSIDE
# ENERGYPLUS_HOME, so the default below usually does not need to change.
ENERGYPLUS_API_PATH=${ENERGYPLUS_HOME}

# Path to the weather file (.epw) used for both baseline and AI runs.
# Download one for your city from https://energyplus.net/weather
WEATHER_FILE=weather/USA_CA_San.Francisco.Intl.AP.724940_TMY3.epw

# Path to the building model used for the baseline (rule-based) run.
BASELINE_IDF=models/baseline.idf

# Path to the building model used for the AI-controlled run.
# By default this is the SAME building geometry as the baseline; the
# closed-loop controller overrides setpoints at runtime via the
# EnergyPlus Python API actuators, so a second IDF is not required.
AI_IDF=models/baseline.idf

# ---------------------------------------------------------
# LLM configuration (open-source, self-hosted)
# ---------------------------------------------------------
# Provider: "ollama" (default) or "openai_compatible" for any other
# self-hosted OpenAI-compatible server (vLLM, LM Studio, text-generation-webui, etc.)
LLM_PROVIDER=ollama

# Base URL of the LLM server.
#   Ollama default:            http://localhost:11434
#   OpenAI-compatible servers: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434

# Model name/tag to use. Any tool-calling-capable open model works well.
# Recommended: qwen2.5:7b-instruct, llama3.1:8b, mistral:7b-instruct
LLM_MODEL=qwen2.5:7b-instruct

# Request timeout (seconds) for a single LLM call.
LLM_TIMEOUT_SECONDS=60

# Optional API key. Ollama does not require one. Some OpenAI-compatible
# servers do - leave blank if not needed.
LLM_API_KEY=

# ---------------------------------------------------------
# Control loop configuration
# ---------------------------------------------------------
# Simulation control-step interval in minutes (how often the agent acts).
CONTROL_INTERVAL_MINUTES=15

# Number of simulated days for each experiment (baseline and AI).
SIMULATION_DAYS=3

# Simulation start month/day (run period). The IDF RunPeriod is derived
# from these values at runtime.
RUN_PERIOD_START_MONTH=7
RUN_PERIOD_START_DAY=1

# ---------------------------------------------------------
# Safety / comfort constraints
# ---------------------------------------------------------
COOLING_SETPOINT_MIN=22.0
COOLING_SETPOINT_MAX=28.0
HEATING_SETPOINT_MIN=18.0
HEATING_SETPOINT_MAX=22.0
MIN_DEADBAND_C=1.5
MAX_SETPOINT_CHANGE_PER_INTERVAL=1.0
PMV_MIN=-0.85
PMV_MAX=0.85
OCCUPIED_TEMP_MIN=20.0
OCCUPIED_TEMP_MAX=27.0

# ---------------------------------------------------------
# Zone name used in the bundled baseline.idf model
# ---------------------------------------------------------
ZONE_NAME=MAIN_ZONE

# ---------------------------------------------------------
# Logging / output
# ---------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
