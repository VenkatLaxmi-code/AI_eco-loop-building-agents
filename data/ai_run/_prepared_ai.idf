!- Windows Line endings 

Version,
    24.1;                     !- Version Identifier

SimulationControl,
    No,                       !- Do Zone Sizing Calculation
    No,                       !- Do System Sizing Calculation
    No,                       !- Do Plant Sizing Calculation
    No,                       !- Run Simulation for Sizing Periods
    Yes,                      !- Run Simulation for Weather File Run Periods
    No,                       !- Do HVAC Sizing Simulation for Sizing Periods
    1;                        !- Maximum Number of HVAC Sizing Simulation Passes

Building,
    Eco-Loop Demo Building,    !- Name
    0,                        !- North Axis
    City,                     !- Terrain
    0.04,                     !- Loads Convergence Tolerance Value
    0.4,                      !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    25,                       !- Maximum Number of Warmup Days
    6;                        !- Minimum Number of Warmup Days

Timestep,
    4;                        !- Number of Timesteps per Hour

Site:Location,
    Generic City,             !- Name
    37.62,                    !- Latitude
    -122.4,                   !- Longitude
    -8,                       !- Time Zone
    2;                        !- Elevation

RunPeriod,
    Eco-Loop Run,             !- Name
    7,                        !- Begin Month
    1,                        !- Begin Day of Month
    2024,                     !- Begin Year
    7,                        !- End Month
    1,                        !- End Day of Month
    2024,                     !- End Year
    ,                         !- Day of Week for Start Day
    No,                       !- Use Weather File Holidays and Special Days
    No,                       !- Use Weather File Daylight Saving Period
    No,                       !- Apply Weekend Holiday Rule
    Yes,                      !- Use Weather File Rain Indicators
    Yes;                      !- Use Weather File Snow Indicators

ScheduleTypeLimits,
    Fraction,                 !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    Continuous;               !- Numeric Type

ScheduleTypeLimits,
    Temperature,              !- Name
    -60,                      !- Lower Limit Value
    200,                      !- Upper Limit Value
    Continuous;               !- Numeric Type

ScheduleTypeLimits,
    Count,                    !- Name
    0,                        !- Lower Limit Value
    100,                      !- Upper Limit Value
    Continuous;               !- Numeric Type

ScheduleTypeLimits,
    ControlType,              !- Name
    0,                        !- Lower Limit Value
    4,                        !- Upper Limit Value
    Discrete;                 !- Numeric Type

Schedule:Compact,
    OCC_SCHED,                !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 08:00,             !- Field 3
    0.0,                      !- Field 4
    Until: 09:00,             !- Field 5
    0.5,                      !- Field 6
    Until: 18:00,             !- Field 7
    1.0,                      !- Field 8
    Until: 19:00,             !- Field 9
    0.3,                      !- Field 10
    Until: 24:00,             !- Field 11
    0.0;                      !- Field 12

Schedule:Compact,
    LIGHTS_SCHED,             !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 07:00,             !- Field 3
    0.05,                     !- Field 4
    Until: 19:00,             !- Field 5
    0.9,                      !- Field 6
    Until: 24:00,             !- Field 7
    0.05;                     !- Field 8

Schedule:Compact,
    EQUIP_SCHED,              !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 07:00,             !- Field 3
    0.10,                     !- Field 4
    Until: 19:00,             !- Field 5
    0.80,                     !- Field 6
    Until: 24:00,             !- Field 7
    0.10;                     !- Field 8

Schedule:Compact,
    ALWAYS_ON,                !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    1.0;                      !- Field 4

Schedule:Compact,
    ACTIVITY_SCHED,           !- Name
    Any Number,               !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    120;                      !- Field 4

Schedule:Compact,
    ZONE_CONTROL_TYPE_SCHED,    !- Name
    ControlType,              !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    4;                        !- Field 4

Schedule:Constant,
    CLG_SETPOINT_SCHED,       !- Name
    Temperature,              !- Schedule Type Limits Name
    24;                       !- Hourly Value

Schedule:Constant,
    HTG_SETPOINT_SCHED,       !- Name
    Temperature,              !- Schedule Type Limits Name
    21;                       !- Hourly Value

Material,
    Concrete Block,           !- Name
    MediumRough,              !- Roughness
    0.2032,                   !- Thickness
    0.72,                     !- Conductivity
    1000,                     !- Density
    920;                      !- Specific Heat

Material,
    Insulation Board,         !- Name
    MediumRough,              !- Roughness
    0.0508,                   !- Thickness
    0.03,                     !- Conductivity
    43,                       !- Density
    1210;                     !- Specific Heat

Material,
    Gypsum Board,             !- Name
    Smooth,                   !- Roughness
    0.0127,                   !- Thickness
    0.16,                     !- Conductivity
    800,                      !- Density
    1090;                     !- Specific Heat

Material,
    Built-up Roofing,         !- Name
    Rough,                    !- Roughness
    0.0095,                   !- Thickness
    0.16,                     !- Conductivity
    1121,                     !- Density
    1460;                     !- Specific Heat

Material,
